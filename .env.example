# Kopier til .env og fyll inn. Ekte .env committes ALDRI (se .gitignore).

# ── App / server ─────────────────────────────────────────────────────────────
CLUB_ID=00000000-0000-0000-0000-000000000000   # UUID fra clubs-raden (samme som dagens VITE_CLUB_ID)
APP_USERNAME=admin                              # brukernavn på login-skjermen
APP_PASSWORD=bytt-meg                           # felles klubbpassord (server-hemmelighet)
ADMIN_PIN=1234                                  # 4-sifret admin-PIN (server-hemmelighet)
SESSION_SECRET=generer-en-lang-tilfeldig-streng # signerer session-cookies (f.eks. `openssl rand -hex 32`)

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=bytt-meg-også                 # passord for db-containeren
# DATABASE_URL bygges i compose fra POSTGRES_PASSWORD med host=db. Settes kun manuelt
# her hvis du kjører backend utenfor compose (f.eks. lokalt mot en localhost-Postgres):
# DATABASE_URL=postgres://baatlogg:bytt-meg-også@localhost:5432/baatlogg
